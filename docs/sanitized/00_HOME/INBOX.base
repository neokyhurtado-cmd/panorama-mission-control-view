name: Atencion
description: Candidatos y elementos pendientes de reconciliacion
filters:
  and:
    - 'file.folder.startsWith("90_INBOX/project_candidates")'
    - 'file.name != "README.md"'
properties:
  file.mtime:
    displayName: Actualizado
summaries:
  file.name: Filled
views:
  - type: table
    name: KPI
    limit: 1
    summaries:
      file.name: Filled
  - type: cards
    name: Pendientes
    order:
      - file.name
      - file.mtime
  - type: table
    name: Tabla
    order:
      - file.name
      - file.mtime
