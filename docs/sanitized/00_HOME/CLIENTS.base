name: Clientes
description: Vista de clientes desde 03_CLIENTS
filters:
  and:
    - 'file.folder.startsWith("03_CLIENTS")'
    - 'file.name != "README.md"'
properties:
  note.tipo:
    displayName: Tipo
  note.proyectos:
    displayName: Proyectos
  note.anios:
    displayName: Anios
  file.mtime:
    displayName: Actualizado
summaries:
  note.tipo: Filled
  note.proyectos: Filled
views:
  - type: table
    name: KPI
    limit: 1
    summaries:
      note.tipo: Filled
  - type: cards
    name: Tarjetas
    order:
      - file.name
      - note.tipo
      - note.proyectos
      - note.anios
  - type: table
    name: Tabla
    order:
      - file.name
      - note.tipo
      - note.proyectos
      - note.anios
      - file.mtime
