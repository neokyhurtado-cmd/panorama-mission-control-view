name: Decisiones
description: Registro de decisiones tomadas en PANORAMA
filters:
  and:
    - 'file.folder.startsWith("05_DECISIONS")'
    - 'file.name != "README.md"'
properties:
  note.type:
    displayName: Tipo
  note.date:
    displayName: Fecha
  note.project:
    displayName: Proyecto
  file.mtime:
    displayName: Actualizado
summaries:
  note.type: Filled
views:
  - type: table
    name: KPI
    limit: 1
    summaries:
      note.type: Filled
  - type: table
    name: Tabla
    order:
      - file.name
      - note.type
      - note.date
      - note.project
      - file.mtime
