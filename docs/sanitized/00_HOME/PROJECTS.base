name: Proyectos
description: Vista de proyectos — estado segun PROJECT.md
filters:
  and:
    - 'file.name == "PROJECT.md"'
    - 'file.folder.startsWith("01_PROJECTS")'
properties:
  note.indicator:
    displayName: ""
  note.status_tag:
    displayName: Tipo
  note.status:
    displayName: Estado
  note.client:
    displayName: Cliente
  note.year:
    displayName: Ano
  note.repos:
    displayName: Repos
  file.mtime:
    displayName: Actualizado
summaries:
  note.status: Filled
  note.client: Filled
  note.year: Filled
views:
  - type: table
    name: KPI
    limit: 1
    summaries:
      note.status: Filled
  - type: cards
    name: Tarjetas
    groupBy:
      property: note.status_tag
      direction: ASC
    order:
      - note.indicator
      - file.name
      - note.status
      - note.client
      - note.year
      - file.mtime
  - type: table
    name: Tabla
    order:
      - note.indicator
      - file.name
      - note.status_tag
      - note.status
      - note.client
      - note.year
      - note.repos
      - file.mtime
